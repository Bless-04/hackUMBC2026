# GuideSense Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini API Key (for multimodal contextual scene description)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (for studio-quality ultra-low latency voice output)
# Get an API key at: https://elevenlabs.io/
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# Backboard.io API Key (optional — for cloud persistent spatial memory)
# Get an API key at: https://backboard.io/
BACKBOARD_API_KEY=your_backboard_api_key_here
